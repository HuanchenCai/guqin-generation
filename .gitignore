# Whitelist: only code, notes and small metadata are tracked.
# Audio, latents, checkpoints and upstream clones (~85 GB) stay out.
/*
!/.gitignore
!/README.md

!/work/
/work/*
!/work/*.py
!/work/*.js
!/work/*.json
!/work/*.md
!/work/guqin_aligned_412/
/work/guqin_aligned_412/*
!/work/guqin_aligned_412/*.json
!/work/guqin_aligned_412/*.csv
!/work/guqin_aligned_412/eval_contexts/
/work/guqin_aligned_412/eval_contexts/*
!/work/guqin_aligned_412/eval_contexts/index.json

!/outputs/
/outputs/*
!/outputs/*.md
!/outputs/*/
/outputs/*/*
!/outputs/*/*.md
!/outputs/*/*.json
!/outputs/*/*.csv
!/outputs/*/index.html

# Paper sources, data behind the paper's numbers, and the built PDF.
!/paper/
/paper/**/*.aux
/paper/**/*.bbl
/paper/**/*.blg
/paper/**/*.fdb_latexmk
/paper/**/*.fls
/paper/**/*.out
/paper/**/*.synctex.gz
/paper/**/*.log
!/paper/data/overfit_validation.log
/paper/tismir/build_*.log
/paper/**/*.maf
/paper/**/*.mtc*
/paper/**/*.toc
/paper/**/*.ent
/paper/**/*.xdv
